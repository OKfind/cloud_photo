{
  "name": "cloud_photo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.next','.open-next']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "npm run clean && next build --webpack",
    "preview": "npm run clean && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run clean && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run clean && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "mongoose": "^8.9.5",
    "next": "16.2.7",
    "proxy-agent": "^5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "typescript": "^5.8.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "wrangler": "^4.98.0"
  }
}
